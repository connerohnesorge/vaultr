# Normalize to LF in the repo regardless of checkout platform.
* text=auto eol=lf

# Executables whose shebang must not be corrupted by CRLF.
*.sh text eol=lf
*.ts text eol=lf

# Captured session data is zstd-compressed and must never be diffed or munged.
*.zst binary
*.jsonl -text

# Generated: keep out of diffs and language stats, still reviewable on demand.
Cargo.lock linguist-generated=true -diff
flake.lock linguist-generated=true -diff
